# Copy this to .env and fill in real values. Never commit .env.

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Default Claude model used by the agent
LEDGER_MODEL=claude-opus-4-7

# Where the ledger SQLite DB lives
LEDGER_DB_PATH=./data/ledger.db

# Log level: DEBUG, INFO, WARNING, ERROR
LEDGER_LOG_LEVEL=INFO

# ---- Phase 2: Plaid (leave blank until you wire it up) ----
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# ---- Phase 3: Teller (alternative for Chase) ----
# TELLER_APPLICATION_ID=
# TELLER_CERTIFICATE_PATH=
# TELLER_PRIVATE_KEY_PATH=
